<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>ASHFALL</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<!-- Landscape only, matching android:screenOrientation="sensorLandscape". -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- Full-screen game: no status bar, no home indicator hugging the HUD. -->
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UIRequiresFullScreen</key>
	<true/>

	<!-- AdMob. The Google Mobile Ads SDK CRASHES ON LAUNCH if this is missing or
	     malformed, exactly like the Android APPLICATION_ID meta-data.
	     This is the iOS AdMob app; the Android one (…~2335827751) will NOT work here.
	     Keep in sync with the iOS unit IDs in js/ads.js. -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-8282887482969580~4250478995</string>
	<!-- NIENTE NSUserTrackingUsageDescription.
	     La sua presenza dichiara ad Apple l'intenzione di chiedere il permesso di
	     tracciamento (ATT), ma il codice non chiama mai requestTrackingAuthorization
	     (non c'e' nessun plugin ATT installato) e l'etichetta privacy dichiara
	     "nessun monitoraggio". Con la chiave presente App Store Connect rifiuta
	     l'invio: "la tua app contiene NSUserTrackingUsageDescription... aggiorna la
	     risposta sulla privacy oppure carica una nuova build".
	     Se un giorno si vorranno annunci personalizzati: reinserire questa chiave,
	     aggiungere un plugin ATT, chiamare l'autorizzazione E aggiornare l'etichetta
	     privacy a "usato per monitoraggio". Le tre cose vanno insieme. -->
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
	</array>
</dict>
</plist>
