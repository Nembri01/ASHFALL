{
  "name": "ashfall",
  "version": "1.0.0",
  "description": "ASHFALL — Wasteland Survival: sparatutto post-apocalittico endless con rewarded ads, per iOS e Android.",
  "private": true,
  "scripts": {
    "serve": "npx --yes serve -l 5173 .",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "build:www": "node tools/build_www.mjs",
    "cap:sync": "node tools/build_www.mjs && npx cap sync",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "assets": "npx @capacitor/assets generate --iconBackgroundColor \"#0a0a0c\" --splashBackgroundColor \"#0a0a0c\""
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "@capacitor/assets": "^3.0.5"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.0",
    "@capacitor/android": "^6.1.0",
    "@capacitor/ios": "^6.1.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/browser": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor-community/admob": "^6.1.0"
  }
}
